# Development. Copie para .env.development.local. Campos vazios desativam o Supabase.
NVMED_ENVIRONMENT=development
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Preencha com o hostname exato apenas para usar o projeto isolado de homologação.
NVMED_SUPABASE_HOMOLOGATION_HOST=
